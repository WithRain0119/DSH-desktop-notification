{
  "name": "dsh-desktop-notification",
  "version": "0.2.0",
  "description": "DSH 桌面/邮件通知插件：任务完成或需要你确认时，在屏幕右下角弹出毛玻璃卡片（可选邮件通知）",
  "type": "module",
  "main": "lib/host.js",
  "bin": {
    "dsh-notify-test": "./bin/dsh-notify-test.js"
  },
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./popup.ps1": "./lib/popup.ps1",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "assets",
    "bin",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "nodemailer": "^10.1.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "notification",
    "desktop-notification",
    "email"
  ],
  "author": "Changenming",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WithRain0119/DSH-desktop-notification.git"
  },
  "homepage": "https://github.com/WithRain0119/DSH-desktop-notification#readme",
  "bugs": {
    "url": "https://github.com/WithRain0119/DSH-desktop-notification/issues"
  },
  "scripts": {
    "test": "node test/popup.test.mjs && node test/host.test.mjs && node test/client.test.mjs",
    "test:popup": "node bin/dsh-notify-test.js test"
  }
}
