{
  "name": "dsh-notify",
  "version": "0.2.0",
  "description": "DSH 桌面/邮件通知插件：任务完成或需要你确认时，在屏幕右下角弹出毛玻璃卡片（可选邮件通知）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./popup.ps1": "./lib/popup.ps1",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "nodemailer": "^10.1.2"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "notification",
    "desktop-notification",
    "email"
  ],
  "author": "Changenming",
  "license": "MIT",
  "scripts": {
    "test": "node bin/dsh-notify.js test"
  }
}
